// Want to change everything to nanoid / cuid soon

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String           @id
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  username            String           @unique
  password            String
  displayName         String?
  compilations        Compilation[]
  permissionsReceived UserPermission[] @relation("PermissionsReceived")
  permissionsGranted  UserPermission[] @relation("PermissionsGranted")
  images              Image[]          @relation("OwnedImages")
  avatar              Image?           @relation("AvatarImage", fields: [avatarId], references: [id])
  avatarId            String?          @unique
  banner              Image?           @relation("BannerImage", fields: [bannerId], references: [id])
  bannerId            String?          @unique
}

model UserPermission {
  id         String     @id
  permission Permission
  grantorId  String
  granteeId  String
  createdAt  DateTime   @default(now())
  grantee    User       @relation("PermissionsReceived", fields: [granteeId], references: [id])
  grantor    User       @relation("PermissionsGranted", fields: [grantorId], references: [id])

  @@unique([grantorId, granteeId, permission])
}

model SpotifyGameAlbum {
  id             String             @id
  name           String
  spotifyAlbumId String
  tracks         SpotifyGameTrack[]
}

model SpotifyGameTrack {
  id                 String             @id
  title              String
  duration           Int
  spotifyGameAlbumId String?
  spotifyGameAlbum   SpotifyGameAlbum?  @relation(fields: [spotifyGameAlbumId], references: [id])
  userDefinedTracks  UserDefinedTrack[]
}

model NintendoMusicLibraryGameAlbum {
  id              String                      @id
  name            String
  nintendoMusicId String?                     @unique
  tracks          NintendoMusicLibraryTrack[]
}

model NintendoMusicLibraryTrack {
  id                              String                         @id
  title                           String
  duration                        Int
  nintendoMusicLibraryGameAlbumId String?
  nintendoMusicId                 String?                        @unique
  nintendoMusicLibraryGameAlbum   NintendoMusicLibraryGameAlbum? @relation(fields: [nintendoMusicLibraryGameAlbumId], references: [id])
  userDefinedTracks               UserDefinedTrack[]
}

model Compilation {
  id                String                @id
  name              String
  description       String
  creatorId         String
  thumbnailId       String?
  thumbnail         Image?                @relation(fields: [thumbnailId], references: [id])
  nintendoMusicURL  String?
  youtubeURL        String?
  visibility        CompilationVisibility @default(PRIVATE)
  creator           User                  @relation(fields: [creatorId], references: [id])
  compilationTracks CompilationTrack[]
  originalRelease   DateTime?
  createdAt         DateTime              @default(now())

  // @@index([creatorId, originalRelease(sort: Desc)]) // TODO: Consider this
}

model CompilationTrack {
  id                 String           @id
  compilationId      String
  position           Int
  addedToNMLPlaylist Boolean
  userDefinedTrackId String
  compilation        Compilation      @relation(fields: [compilationId], references: [id])
  userDefinedTrack   UserDefinedTrack @relation(fields: [userDefinedTrackId], references: [id])
}

model UserDefinedAlbum {
  id     String             @id
  name   String             @unique
  tracks UserDefinedTrack[]
}

model UserDefinedTrack {
  id                          String                     @id
  title                       String
  duration                    Int
  userDefinedAlbumId          String
  nintendoMusicLibraryTrackId String?
  spotifyGameTrackId          String?
  compilationTracks           CompilationTrack[]
  nintendoMusicLibraryTrack   NintendoMusicLibraryTrack? @relation(fields: [nintendoMusicLibraryTrackId], references: [id])
  spotifyGameTrack            SpotifyGameTrack?          @relation(fields: [spotifyGameTrackId], references: [id])
  userDefinedAlbum            UserDefinedAlbum           @relation(fields: [userDefinedAlbumId], references: [id])
}

enum Permission {
  OVERLORD
  IMPERSONATE_CREATE_COMPILATION
  IMPERSONATE_EDIT_COMPILATION
  IMPERSONATE_DELETE_COMPILATION
  CREATE_NINTENDO_MUSIC_TRACK
  CREATE_NINTENDO_MUSIC_ALBUM
  IMPERSONATE_EDIT_USER
}

enum CompilationVisibility {
  PRIVATE
  PUBLIC
}

enum ImageType {
  PROFILE_PICTURE
  THUMBNAIL
  BANNER
}

model Image {
  id           String        @id @default(cuid())
  remoteKey    String        @unique
  type         ImageType
  ownerId      String
  owner        User          @relation("OwnedImages", fields: [ownerId], references: [id])
  createdAt    DateTime      @default(now())
  compilations Compilation[]
  avatarOwner  User?         @relation("AvatarImage")
  bannerOwner  User?         @relation("BannerImage")
}
